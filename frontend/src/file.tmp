        <h1>Ausleihzentrale für Schulen</h1>
        <p class="intro">
          Für Bücher, Medien, Geräte, etc.
        </p>
        <p class="doc-link-row">
          <a
            class="doc-link"
            href="http://localhost:3001/api/docs"
            target="_blank"
            rel="noreferrer"
          >
            API-Doku oeffnen
          </a>
        </p>
      </div>

      <div class="status-stack">
        <div class="user-chip">
          <span class="user-avatar">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="18" height="18">
              <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/>
            </svg>
          </span>
          <span class="user-info">
            <strong>Maria Musterfrau</strong>
            <small>Bibliothek</small>
          </span>
          <button class="logout-btn" title="Abmelden">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
              <polyline points="16 17 21 12 16 7"/>
              <line x1="21" y1="12" x2="9" y2="12"/>
            </svg>
          </button>
        </div>
        <p v-if="apiFehler" class="feedback error">{{ apiFehler }}</p>
        <p v-if="erfolgsMeldung" class="feedback success">{{ erfolgsMeldung }}</p>
      </div>
    </section>

    <section class="kennzahlen-grid" v-if="dashboard">
      <article class="kennzahl">
        <span>Exemplare gesamt</span>
        <strong>{{ dashboard.exemplare_gesamt }}</strong>
      </article>
      <article class="kennzahl">
        <span>Verfuegbar</span>
        <strong>{{ dashboard.verfuegbar }}</strong>
      </article>
      <article class="kennzahl">
        <span>Ausgeliehen</span>
        <strong>{{ dashboard.ausgeliehen }}</strong>
      </article>
      <article class="kennzahl">
        <span>Problemfaelle</span>
        <strong>{{ dashboard.problemfaelle }}</strong>
      </article>
      <article class="kennzahl">
        <span>Buecher</span>
        <strong>{{ dashboard.buecher }}</strong>
      </article>
      <article class="kennzahl">
        <span>Geraete</span>
        <strong>{{ dashboard.geraete }}</strong>
      </article>
    </section>

    <ModulNavigation
      :module="modulNavigation"
      :aktives-modul="aktivesModul"
      @wechsel="wechsleModul"
    />

    <!-- Dynamisches Rendern der Routen über Vue Router -->
    <router-view v-slot="{ Component }">
      <component
        :is="Component"
        :modus="aktivesModul"
        :scanner-geraet-label="scannerGeraetLabel"
        :manuelle-code-eingabe="manuelleCodeEingabe"
        :scanner-status="scannerStatus"
        :scan-result="scanResult"
        :scan-type="scanType"
        :last-error="lastError"
        :scan-dialog="scanDialog"
        :scan-bereit-zur-ausleihe="scanBereitZurAusleihe"
        :scan-bereit-zur-rueckgabe="scanBereitZurRueckgabe"
        :scan-dialog-hinweis="scanHinweisText"
        :scan-offene-ausleihen-des-ausleihers="scanOffeneAusleihenDesAusleihers"
        :markierte-scan-ausleihen="markierteScanAusleihen"
        :ausleihe-form="ausleiheForm"
        :rueckgabe-form="rueckgabeForm"
        :verlaengerung-form="verlaengerungForm"
        :scan-offene-ausleihe-zur-rueckgabe="scanAktiveAusleihe"
        :lehrkraft-ausleiher="lehrkraftAusleiher"
        :schueler-ausleiher="schuelerAusleiher"
