        :historie-eintraege="historieEintraege"
        :ausleihe-manuelle-exemplar-eingabe="ausleiheManuelleExemplarEingabe"
        :ausleihe-scan-exemplar-eingabe="ausleiheScanExemplarEingabe"
        :klassensatz-form="klassensatzForm"
        :klassensatz-gruppen="klassensatzGruppen"
        :ist-klassensatz-gruppe-ausgewaehlt="istKlassensatzGruppeAusgewaehlt"
        :exemplare="exemplare"
        :laedt-daten="laedtDaten"
        :ausgewaehltes-exemplar="ausgewaehltesExemplar"
        :ausgewaehltes-buch="ausgewaehltesBuch"
        :ausgewaehltes-exemplar-id="ausgewaehltesExemplarId"
        :exemplar-form="exemplarForm"
        :standorte="standorte"
        :objekt-historie="objektHistorie"
        :objekt-historie-seite="objektHistorieSeite"
        :objekt-historie-gesamt="objektHistorieGesamt"
        :objekt-historie-limit="objektHistorieLimit"
        :geraete-gefiltert="geraeteGefiltert"
        :geraete-suche="geraeteSuche"
        :geraete-alle-ausgewaehlt="geraeteAlleAusgewaehlt"
        :geraete-ausgewaehlt="geraeteAusgewaehlt"
        :faecher="faecher"
        :herkunft="herkunft"
        :api-request="apiRequest"
        :externer-buch-titelcode="externerBuchTitelcode"
        :barcode-druck-eintraege="barcodeDruckEintraege"
        :druck-kategorie="druckKategorie"
        :druck-code-format="druckCodeFormat"
        :druck-filter="druckFilter"
        :druck-filter-aktiv="druckFilterAktiv"
        :inventar-typen-fuer-druck="inventarTypenFuerDruck"
        :statuswerte-fuer-druck="statuswerteFuerDruck"
        :standorte-fuer-druck="standorteFuerDruck"
        :klassen-fuer-druck="klassenFuerDruck"
        :fachbereiche-fuer-druck="fachbereicheFuerDruck"
        :qr-code-svg-map="qrCodeSvgMap"
        :code39-svg="code39Svg"
        :offene-schaeden="offeneSchaeden"
        :offene-reparaturen="offeneReparaturen"
        :schaden-form="schadenForm"
        :reparatur-form="reparaturForm"
        :reparaturen="reparaturen"
        :historie-gesamt="historieGesamt"
        :historie-datum-filter="historieDatumFilter"
        :historie-filter="historieFilter"
        :historie-nach-datum="historieNachDatum"
        :historie-hat-buchlink="historieHatBuchlink"
        :historie-loesch-tage="historieLoeschTage"
        :historie-kann-mehr-laden="historieKannMehrLaden"
        :historie-laedt-mehr="historieLaedtMehr"
        @update:manuelle-code-eingabe="manuelleCodeEingabe = $event"
        @update:markierte-scan-ausleihen="markierteScanAusleihen = $event"
        @manuelle-pruefung="manuelleCodePruefung"
        @scan-bestaetigen="scanAusleiheBestaetigen"
        @ausleihe-starten="ausleiheSpeichernMitOptionen({ behalteAusleiher: true })"
        @scan-rueckgabe="scanRueckgabeBestaetigen"
        @scan-verlaengern="scanVerlaengerungOeffnen"
        @rueckgabe-buchen="rueckgabeSpeichern"
        @rueckgabe-abbrechen="startRueckgabeAbbrechen"
        @verlaengerung-speichern="verlaengerungSpeichern"
        @verlaengerung-abbrechen="startVerlaengerungAbbrechen"
        @scan-zuruecksetzen="appResetResult"
        @update:ausleihe-manuelle-exemplar-eingabe="ausleiheManuelleExemplarEingabe = $event"
        @update:ausleihe-scan-exemplar-eingabe="ausleiheScanExemplarEingabe = $event"
        @suche-manuell="manuellesAusleiheExemplarSuchen"
        @scan-uebernehmen="scanEingabeAusleiheExemplarUebernehmen"
        @ausleihe-speichern="ausleiheSpeichern"
        @rueckgabe-speichern="rueckgabeSpeichern"
        @toggle-klassensatz-gruppe="toggleKlassensatzGruppe"
        @klassensatz-speichern="klassensatzAusgabeSpeichern"
        @update:ausgewaehltes-exemplar-id="ausgewaehltesExemplarId = $event"
        @waehle-exemplar="waehleExemplar"
        @exemplar-speichern="exemplarSpeichern"
        @historie-seite-wechseln="ladeObjektHistorie(ausgewaehltesExemplarId, $event)"
        @update:externer-buch-titelcode="externerBuchTitelcode = $event"
        @zeige-erfolg="erfolgsMeldung = $event"
        @zeige-fehler="apiFehler = $event"
        @zeige-scanner-status="scannerStatus = $event"
        @lade-daten="ladeDaten"
        @update:geraete-suche="geraeteSuche = $event"
        @update:geraete-alle-ausgewaehlt="geraeteAlleAusgewaehlt = $event"
        @toggle-geraet-auswahl="toggleKlassensatzExemplar"
        @geraete-auswahl-loeschen-anfragen="geraeteAuswahlLoeschenAnfragen"
        @bearbeite-geraet="springeZurObjektpflege"
        @update:druck-kategorie="druckKategorie = $event"
        @update:druck-code-format="druckCodeFormat = $event"
        @drucke-barcodes="druckeBarcodes"
        @druckfilter-zuruecksetzen="druckFilterZuruecksetzen"
        @schaden-speichern="schadenSpeichern"
        @reparatur-starten="reparaturStarten"
        @reparatur-abschliessen="reparaturAbschliessen"
        @update:historie-datum-filter="historieDatumFilter = $event"
        @update:historie-filter="historieFilter = $event"
        @update:historie-loesch-tage="historieLoeschTage = $event"
        @zeige-buchdetails="zeigeBuchdetailsAusHistorie"
        @historie-loeschen="historieLoeschenAnfragen"
        @historie-mehr-laden="ladeWeitereHistorie"
      />
    </router-view>

    <!-- Bestätigungs-Overlay Löschen -->
    <Teleport to="body">
      <div v-if="loeschenDialog" class="overlay-backdrop" @click.self="loeschenDialog = false">
        <div class="confirm-dialog">
          <h3>Exemplare löschen</h3>
          <p>
            {{ geraeteAusgewaehlt.size }} Exemplar{{ geraeteAusgewaehlt.size === 1 ? '' : 'e' }}
            unwiderruflich löschen?
          </p>
          <p v-if="loeschenFehler" class="confirm-dialog-fehler">{{ loeschenFehler }}</p>
          <div class="confirm-dialog-actions">
            <button class="btn-secondary" @click="loeschenDialog = false">Abbrechen</button>
            <button class="danger" @click="geraeteAuswahlLoeschenBestaetigen">Löschen</button>
          </div>
        </div>
      </div>
    </Teleport>

    <Teleport to="body">
      <div v-if="historieLoeschenDialog" class="overlay-backdrop" @click.self="historieLoeschenDialog = false">
        <div class="confirm-dialog">
          <h3>Historie bereinigen</h3>
          <p>
            Alle Historie-Eintraege unwiderruflich loeschen, die aelter als
            {{ historieLoeschTage }} Tage sind?
          </p>
          <p v-if="loeschenFehler" class="confirm-dialog-fehler">{{ loeschenFehler }}</p>
          <div class="confirm-dialog-actions">
            <button class="btn-secondary" @click="historieLoeschenDialog = false">Abbrechen</button>
            <button class="danger" @click="historieLoeschen">Loeschen</button>
          </div>
        </div>
      </div>
    </Teleport>

    <!-- Buch-Overlay aus Historie -->
    <Teleport to="body">
      <div v-if="overlayExemplarId" class="overlay-backdrop" @click.self="overlayExemplarId = null">
        <div class="overlay-panel">
          <div class="overlay-head">
            <div>
              <h2>{{ overlayExemplar?.titel ?? '—' }}</h2>
              <span class="subtle">{{ overlayExemplar?.inventarnummer }}</span>
            </div>
            <button class="overlay-close" @click="overlayExemplarId = null">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
              </svg>
            </button>
          </div>

          <div class="overlay-body">
            <div v-if="overlayExemplar?.cover_bild || overlayExemplar?.cover_url" class="buch-cover-box">
              <img
                :src="overlayExemplar.cover_bild || overlayExemplar.cover_url"
                    :alt="`Cover von ${overlayExemplar?.titel}`"
                    class="buch-cover"
                  />
                </div>
                
                <div class="historie-liste" style="margin-top: 1rem;">
                  <article v-for="eintrag in (overlayHistorie.eintraege || overlayHistorie)" :key="`overlay-hist-${eintrag.id}`" class="historie-eintrag">
                    <div class="historie-kopf">
                      <strong>{{ eintrag.titel }}</strong>
                      <span>{{ formatDatum(eintrag.erstellt_am) }}</span>
                    </div>
                    <p>{{ eintrag.details }}</p>
                  </article>
                </div>
              </div>
            </div>
          </div>
        </Teleport>
  </main>
</template>